# Application
APP_NAME=Salary
APP_DEBUG=true
APP_URL=http://localhost/salary
APP_BASE_PATH=/salary

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=salary
DB_USERNAME=root
DB_PASSWORD=
