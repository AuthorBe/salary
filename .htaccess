# Root .htaccess (Production InfinityFree)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Jika request sudah menuju folder public/, stop rewrite
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    # 2. Redirect semua request langsung ke dalam folder public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>