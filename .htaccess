# Root .htaccess
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Jika request sudah ke public/, stop rewrite
    RewriteCond %{REQUEST_URI} ^/public/ [OR]
    RewriteCond %{REQUEST_URI} ^/salary/public/ [OR]
    RewriteCond %{REQUEST_URI} ^/payrun/public/
    RewriteRule ^ - [L]

    # 2. Jika request diawali dengan salary/ atau payrun/, strip prefix dan ke public/
    RewriteRule ^salary/(.*)$ public/$1 [L,QSA]
    RewriteRule ^payrun/(.*)$ public/$1 [L,QSA]

    # 3. Semua request lainnya ke public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
